# ============================================================
# FinFlow Data Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in actual values:
# cp .env.example .env
# NEVER commit .env to Git.
# ============================================================

# --- PostgreSQL (Source Database) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finflow
POSTGRES_USER=finflow_admin
POSTGRES_PASSWORD=CHANGE_ME

# --- MinIO (S3-Compatible Data Lake) ---
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=finflow_minio
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_RAW=finflow-raw
MINIO_BUCKET_BRONZE=finflow-bronze
MINIO_BUCKET_SILVER=finflow-silver
MINIO_BUCKET_GOLD=finflow-gold
MINIO_BUCKET_QUARANTINE=finflow-quarantine

# --- Apache Kafka ---
KAFKA_BROKER=kafka:9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CLUSTER_ID=CHANGE_ME

# --- ClickHouse (Analytical Warehouse) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=finflow
CLICKHOUSE_USER=finflow_analyst
CLICKHOUSE_PASSWORD=CHANGE_ME

# --- Apache Airflow ---
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME

# --- Apache NiFi ---
NIFI_WEB_HTTP_PORT=8443
NIFI_SINGLE_USER_CREDENTIALS_USERNAME=admin
NIFI_SINGLE_USER_CREDENTIALS_PASSWORD=CHANGE_ME

# --- OpenSearch ---
OPENSEARCH_PORT=9200
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME

# --- Apache Superset ---
SUPERSET_SECRET_KEY=CHANGE_ME
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME

# --- OpenMetadata ---
OPENMETADATA_ADMIN_PASSWORD=CHANGE_ME

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- FastAPI (Source API) ---
FASTAPI_PORT=8000
FASTAPI_API_KEY=CHANGE_ME

# --- General ---
COMPOSE_PROJECT_NAME=finflow
